import org.apache.tika.Tika;
import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.web.bind.annotation.*;
import org.springframework.web.multipart.MultipartFile;

import java.io.File;
import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.StandardCopyOption;
import java.util.*;

// Trie Node for Skill Matching
class TrieNode {
    Map<Character, TrieNode> children = new HashMap<>();
    boolean isEndOfWord;
}

// Trie Data Structure
class SkillTrie {
    private final TrieNode root = new TrieNode();

    public void insert(String skill) {
        TrieNode node = root;
        for (char ch : skill.toLowerCase().toCharArray()) {
            node.children.putIfAbsent(ch, new TrieNode());
            node = node.children.get(ch);
        }
        node.isEndOfWord = true;
    }

    public boolean search(String word) {
        TrieNode node = root;
        for (char ch : word.toLowerCase().toCharArray()) {
            if (!node.children.containsKey(ch)) return false;
            node = node.children.get(ch);
        }
        return node.isEndOfWord;
    }
}

// Resume Parser & Ranking System
class ResumeRanker {
    private final SkillTrie skillTrie = new SkillTrie();
    private final PriorityQueue<ResumeScore> rankedResumes = new PriorityQueue<>(Comparator.reverseOrder());

    public ResumeRanker(List<String> skills) {
        for (String skill : skills) skillTrie.insert(skill);
    }

    public String extractTextFromResume(File file) throws IOException {
        return new Tika().parseToString(file);
    }

    public int calculateScore(String resumeText) {
        int score = 0;
        for (String word : resumeText.split("\\s+")) {
            if (skillTrie.search(word)) score++;
        }
        return score;
    }

    public void rankResume(File resume) throws IOException {
        String content = extractTextFromResume(resume);
        int score = calculateScore(content);
        rankedResumes.add(new ResumeScore(resume.getName(), score));
    }

    public List<ResumeScore> getRankedResumes() {
        List<ResumeScore> results = new ArrayList<>(rankedResumes);
        results.sort(Comparator.reverseOrder());
        return results;
    }
}

// Resume Score Object
class ResumeScore implements Comparable<ResumeScore> {
    String name;
    int score;

    public ResumeScore(String name, int score) {
        this.name = name;
        this.score = score;
    }

    @Override
    public int compareTo(ResumeScore other) {
        return Integer.compare(this.score, other.score);
    }

    @Override
    public String toString() {
        return name + " - Score: " + score;
    }
}

// Spring Boot Application
@SpringBootApplication
@RestController
@RequestMapping("/resume")
public class ResumeRankingApp {
    private final ResumeRanker ranker = new ResumeRanker(Arrays.asList("Java", "Spring", "Machine Learning", "AI", "Python"));

    @PostMapping("/upload")
    public String uploadResume(@RequestParam("file") MultipartFile file) {
        try {
            Path tempFile = Files.createTempFile("resume", file.getOriginalFilename());
            Files.copy(file.getInputStream(), tempFile, StandardCopyOption.REPLACE_EXISTING);
            ranker.rankResume(tempFile.toFile());
            return "Resume uploaded and ranked successfully.";
        } catch (IOException e) {
            return "Error processing resume: " + e.getMessage();
        }
    }

    @GetMapping("/ranked")
    public List<ResumeScore> getRankedResumes() {
        return ranker.getRankedResumes();
    }

    public static void main(String[] args) {
        SpringApplication.run(ResumeRankingApp.class, args);
    }
}
